{
  "version": 2,
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "chsb-onlayn": {
      "root": "chsb-onlayn",
      "framework": "vite"
    },
    "backend": {
      "root": "chsb-onlayn/backend",
      "framework": "express",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "builds": [
    {
      "src": "src/server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.ts"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/((?!api/).*)",
      "destination": {
        "service": "chsb-onlayn"
      }
    }
  ]
}